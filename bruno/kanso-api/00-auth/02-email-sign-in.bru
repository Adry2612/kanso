meta {
  name: Sign in with email and password
  type: http
  seq: 2
}

post {
  url: {{identityToolkitUrl}}/accounts:signInWithPassword?key={{firebaseApiKey}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}",
    "returnSecureToken": true
  }
}

script:post-response {
  const data = res.getBody();
  if (data?.idToken) {
    bru.setEnvVar("idToken", data.idToken, { persist: true });
  }
  if (data?.localId) {
    bru.setEnvVar("uid", data.localId, { persist: true });
  }
}
