meta {
  name: Get album by mood
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/getAlbumsByMood
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{idToken}}
  Content-Type: application/json
}

body:json {
  {
    "moods": ["{{collectionMood}}"],
    "format": "{{collectionFormat}}",
    "tags": []
  }
}
