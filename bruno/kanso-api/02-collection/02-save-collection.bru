meta {
  name: Save collection album
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/collection
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{idToken}}
  Content-Type: application/json
}

body:json {
  {
    "album": {
      "album_type": "album",
      "total_tracks": 12,
      "available_markets": ["ES"],
      "external_urls": {
        "spotify": "https://open.spotify.com/album/{{albumId}}"
      },
      "href": "https://api.spotify.com/v1/albums/{{albumId}}",
      "id": "{{albumId}}",
      "images": [
        {
          "height": 640,
          "width": 640,
          "url": "https://example.com/album-cover.jpg"
        }
      ],
      "name": "OK Computer",
      "release_date": "1997-05-28",
      "release_date_precision": "day",
      "type": "album",
      "uri": "spotify:album:{{albumId}}",
      "artists": [
        {
          "external_urls": {
            "spotify": "https://open.spotify.com/artist/{{artistId}}"
          },
          "href": "https://api.spotify.com/v1/artists/{{artistId}}",
          "id": "{{artistId}}",
          "name": "Radiohead",
          "type": "artist",
          "uri": "spotify:artist:{{artistId}}"
        }
      ]
    },
    "feelings": ["{{collectionMood}}"],
    "format": ["{{collectionFormat}}"],
    "activities": ["{{collectionActivity}}"],
    "tags": [
      {
        "category": "genero",
        "value": "alternativo"
      }
    ]
  }
}
