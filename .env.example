# Firebase web config (NEXT_PUBLIC_* values are public: they ship in the client
# bundle). Access control comes from Firestore Security Rules + App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-only secret: never prefix with NEXT_PUBLIC_).
# Verifica los ID tokens y accede a Firestore con privilegios, ya que las reglas
# deniegan el acceso directo del cliente. Usa UNA de las dos formas:
#   a) el JSON completo de la service account en una sola línea, o
#   b) la ruta absoluta al fichero .json.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Spotify (server-only secrets: never prefix with NEXT_PUBLIC_)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
