# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*

# artefactos de MCP (Playwright: capturas y snapshots)
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Bruno local environment (generated from .env; may contain session tokens)
/bruno/kanso-api/environments/Local.bru

# Firebase service account keys (server-only credentials)
serviceAccount*.json
*service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
